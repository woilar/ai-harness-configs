{
  "name": "opencode-learning-detour",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "scripts"
  ],
  "engines": {
    "node": ">=22"
