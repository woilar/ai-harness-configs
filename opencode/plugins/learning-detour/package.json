    "jsonc-parser": "^3.3.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "solid-js": "^1.9.9",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vite-plugin-solid": "^2.11.8"
  }
}
